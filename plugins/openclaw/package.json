{
  "name": "@drakon-systems/shieldcortex-realtime",
  "version": "4.22.1",
  "description": "OpenClaw plugin for ShieldCortex real-time defence scanning and optional memory extraction.",
  "type": "module",
  "main": "./dist/index.js",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "shieldcortex",
    "security",
    "prompt-injection",
    "memory"
  ],
  "files": [
    "dist/",
    "index.ts",
    "interceptor.ts",
    "intercept-ingest.ts",
    "cloud-sync.ts",
    "openclaw.plugin.json",
    "README.md",
    "llm_input/",
    "llm_output/",
    "before_tool_call/",
    "session_end/"
  ],
  "scripts": {
    "pack:verify": "npm pack --dry-run"
  },
  "peerDependencies": {
    "shieldcortex": ">=4.18.3 <5.0.0",
    "openclaw": ">=2026.3.22"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "openclaw": ">=2026.4.23"
  },
  "publishConfig": {
    "access": "public"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "hooks": [
      "llm_input",
      "llm_output",
      "before_tool_call",
      "session_end"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drakon-Systems-Ltd/ShieldCortex.git",
    "directory": "plugins/openclaw"
  },
  "homepage": "https://github.com/Drakon-Systems-Ltd/ShieldCortex/tree/main/plugins/openclaw#readme",
  "bugs": {
    "url": "https://github.com/Drakon-Systems-Ltd/ShieldCortex/issues"
  }
}
