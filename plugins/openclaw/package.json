{
  "name": "@drakon-systems/shieldcortex-realtime",
  "version": "4.12.10",
  "description": "OpenClaw plugin for ShieldCortex real-time defence scanning and optional memory extraction.",
  "type": "module",
  "main": "index.ts",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "shieldcortex",
    "security",
    "prompt-injection",
    "memory"
  ],
  "files": [
    "index.ts",
    "interceptor.ts",
    "intercept-ingest.ts",
    "cloud-sync.ts",
